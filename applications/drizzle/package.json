{
  "name": "@supschema/drizzle",
  "version": "0.0.6",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "supschema-dev": "./index.ts",
      "default": "./dist/index.js"
    },
    "./postgresql": {
      "supschema-dev": "./postgresql.ts",
      "default": "./dist/postgresql.js"
    },
    "./mysql": {
      "supschema-dev": "./mysql.ts",
      "default": "./dist/mysql.js"
    },
    "./sqlite": {
      "supschema-dev": "./sqlite.ts",
      "default": "./dist/sqlite.js"
    },
    "./*": {
      "supschema-dev": "./*",
      "default": "./dist/*"
    }
  },
  "dependencies": {
    "@supschema/core": "workspace:*",
    "@supschema/model-types": "workspace:*",
    "remeda": "^2.39.0"
  },
  "optionalDependencies": {
    "@supschema/common-types": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "*"
  },
  "author": "Alexey Balekhov <alexeybalekhov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balek/supschema.git"
  },
  "license": "MIT",
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4"
  }
}
